{
  "openapi": "3.0.3",
  "info": {
    "title": "Notes Markdown vault API",
    "version": "0.1.0-alpha.9"
  },
  "paths": {
    "/api/tree": {
      "get": {
        "summary": "Nested folders first then notes, sorted by name",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        }
      }
    },
    "/api/note": {
      "get": {
        "summary": "Read note content and SHA-256 revision",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "summary": "Atomically replace an existing note with matching revision",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "rev": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "rev",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a note without overwriting",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          },
          "201": {
            "description": "Created"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/folder": {
      "post": {
        "summary": "Create one nested folder",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/move": {
      "post": {
        "summary": "Move or rename without overwriting (links are not rewritten)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/delete": {
      "post": {
        "summary": "Move to recoverable trash; returns trash_id",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/restore": {
      "post": {
        "summary": "Restore a trash entry to its original unoccupied path",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trash_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "trash_id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Titles first, then body, with snippets; empty query returns recent notes",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/backlinks": {
      "get": {
        "summary": "List notes linking to this note",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/resolve": {
      "get": {
        "summary": "Case-insensitive wiki target resolution; path=null when missing",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/image": {
      "get": {
        "summary": "A vault image (png, jpg, gif, webp, avif, bmp) for Read view, found like Obsidian: next to the current note, then vault-relative, then the shortest path with that name. Same path gate as notes. 404 unless the read-images switch is on.",
        "responses": {
          "200": {
            "description": "Image bytes",
            "content": {
              "image/*": {}
            }
          },
          "400": {
            "description": "Invalid path or not an image"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found, or the read-images switch is off"
          },
          "413": {
            "description": "Image too large"
          }
        },
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/today": {
      "post": {
        "summary": "Create/open Daily/YYYY-MM-DD.md in Asia/Bangkok",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/switches": {
      "get": {
        "summary": "Owner feature switches (wizard.app-switches/1), off by default",
        "responses": {
          "200": {
            "description": "{contract, switches:[{id,name,description,on,default,issues}]}"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      },
      "post": {
        "summary": "Turn one owner feature switch on or off. Needs the box Origin and X-Wizard-Switch: 1",
        "responses": {
          "200": {
            "description": "The same listing as GET"
          },
          "400": {
            "description": "Invalid body"
          },
          "403": {
            "description": "Not the owner's page or the App Manager"
          },
          "404": {
            "description": "No such switch"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "on": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "on"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid path or input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision conflict or occupied name. Reread and reconcile; never overwrite."
          }
        }
      }
    }
  }
}
